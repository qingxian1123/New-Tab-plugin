{
  "manifest_version": 3,
  "name": "Inspirational New Tab",
  "version": "1.0",
  "description": "A new tab page like chrome default new tab",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "host_permissions": [
        "https://logo.clearbit.com/*",
        "https://www.google.com/s2/favicons*",
        "https://t0.gstatic.com/*" 
    ]
}