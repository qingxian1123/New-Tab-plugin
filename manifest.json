{
  "manifest_version": 3,
  "name": "Inspirational New Tab",
  "version": "2.0",
  "description": "A clean, modern new tab page",
  "icons": {
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "search",
    "bookmarks",
    "favicon"
  ]
}
